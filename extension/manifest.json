{
  "manifest_version": 3,
  "name": "HackerRank Contest Tracking",
  "version": "6.0.0",
  "description": "Authorized contest monitoring extension.",
  "permissions": ["tabs", "storage", "windows", "scripting", "alarms"],
  "host_permissions": [
    "https://www.hackerrank.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.hackerrank.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
